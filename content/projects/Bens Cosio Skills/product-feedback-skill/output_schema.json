{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Feedback Extraction Output",
  "type": "object",
  "required": [
    "summary_markdown",
    "feedback"
  ],
  "properties": {
    "summary_markdown": {
      "type": "string",
      "description": "Concise PM-ready markdown summary."
    },
    "feedback": {
      "type": "object",
      "required": [
        "what_help_is_needed",
        "customer_scenario_and_desired_outcome",
        "customer_impact",
        "workaround_details",
        "priority",
        "quality_assessment",
        "evidence",
        "open_questions"
      ],
      "properties": {
        "what_help_is_needed": {
          "type": "string"
        },
        "customer_scenario_and_desired_outcome": {
          "type": "string"
        },
        "customer_impact": {
          "type": "string"
        },
        "workaround_details": {
          "type": "string"
        },
        "priority": {
          "type": "object",
          "required": [
            "severity",
            "urgency",
            "feature_area",
            "rationale"
          ],
          "properties": {
            "severity": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"]
            },
            "urgency": {
              "type": "string",
              "enum": ["low", "medium", "high", "immediate"]
            },
            "feature_area": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "quality_assessment": {
          "type": "object",
          "required": [
            "label",
            "overall_quality_score",
            "component_scores",
            "confidence"
          ],
          "properties": {
            "label": {
              "type": "string",
              "enum": ["insufficient", "good", "excellent"]
            },
            "overall_quality_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "component_scores": {
              "type": "object",
              "required": [
                "what_help_is_needed",
                "customer_scenario_and_desired_outcome",
                "customer_impact",
                "workaround_details"
              ],
              "properties": {
                "what_help_is_needed": { "type": "number", "minimum": 0, "maximum": 5 },
                "customer_scenario_and_desired_outcome": { "type": "number", "minimum": 0, "maximum": 5 },
                "customer_impact": { "type": "number", "minimum": 0, "maximum": 5 },
                "workaround_details": { "type": "number", "minimum": 0, "maximum": 5 }
              },
              "additionalProperties": false
            },
            "confidence": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quote", "supports"],
            "properties": {
              "quote": { "type": "string" },
              "supports": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "what_help_is_needed",
                    "customer_scenario_and_desired_outcome",
                    "customer_impact",
                    "workaround_details",
                    "priority"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

