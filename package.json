{
  "name": "benmartinbaur-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-static-routes.mjs && node scripts/verify-static-build.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:static": "node --test tests/static-build.test.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "check:links": "node scripts/check-links.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "quality:static": "npm run lint && npm run build && npm run test:static && npm run check:links && npm run audit:dependencies",
    "quality": "npm run quality:static && npm run test:e2e && npm run test:lighthouse"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
